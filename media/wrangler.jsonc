// media, the picture proxy, as a Worker: a web picture fetched for the reader, so its site never learns who read it.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "media",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  // Only on its own domain: no workers.dev copy once this is live.
  "workers_dev": false,
  "routes": [{ "pattern": "media.tinylittleoffice.com", "custom_domain": true }],
  // A brake on one address asking for many pictures: 120 a minute, counted per Cloudflare location, in memory, never written down.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "2", "simple": { "limit": 120, "period": 60 } }],
  // No logs: the proxy learns which picture was asked for, and keeps even that to itself.
  "observability": { "enabled": false }
}
