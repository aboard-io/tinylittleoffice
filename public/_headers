# Headers for the site on Cloudflare (Workers static assets). The build fills {{scripts}} with the hash of every
# script the apps' pages carry (pageScript in src/kit/page.ts), so no other inline script can run, even in a frame.
# (The Website Builder's frame inherits this policy; its editing script is the site's own file, /site-frame.js, by 'self'.)
# The site is its own only source of code and style; nothing may embed the editor (frame-ancestors 'none') but the
# embed page, /embed/ (the embed view: the pages alone, for another site's frame), below. Where the site may reach is
# filled in by scripts/headers.ts from src/kit/network.ts, the one list of every host (docs/network.md, /network):
# {{media}} is the picture proxy (every web picture is fetched through it; an export fetches a picture's bytes), and
# {{img}}, {{connect}}, {{frame}} and {{media-src}} the hosts the list allows by each directive: the map's tiles, place
# search, the short-link service, Bluesky and Wikipedia, and a thing from the web only in a sandboxed frame made
# after a tap, as the embeds do. Nothing else.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' {{scripts}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{media}} {{img}}; font-src 'self' data:; media-src {{media-src}}; connect-src 'self' data: {{media}} {{connect}}; worker-src 'self'; frame-src 'self' about: blob: {{frame}}; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'
  Cache-Control: no-cache
# The pages themselves: no-transform, so Cloudflare does not rewrite them to add its analytics beacon (which the
# policy above would block anyway). Only the HTML: the scripts keep their compression.
/
  ! Cache-Control
  Cache-Control: no-cache, no-transform
/:app/
  ! Cache-Control
  Cache-Control: no-cache, no-transform
# Built files carry a hash in their name: once fetched, they are never asked for again.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# The embed page: the same policy, but any page may frame it (it shows the document's pages and a link to open them).
/embed/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' {{scripts}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src https:; connect-src 'self' data:; worker-src 'self'; frame-src 'self' about: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors *
  ! Cache-Control
  Cache-Control: no-cache, no-transform
# For programs: the guide (/llms.txt), the API (/api.js, and the pieces of it under /api/) and the helper for
# pages (/tinyoffice.js) from any origin.
/tinyoffice.js
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *
/api.js
  Access-Control-Allow-Origin: *
/api/*
  Access-Control-Allow-Origin: *
