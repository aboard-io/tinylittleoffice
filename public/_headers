# Headers for the site on Cloudflare (Workers static assets). The build fills {{scripts}} with the hash of every
# script the apps' pages carry (pageScript in src/kit/core.ts), so no other inline script can run, even in a frame.
# The site is its own only source of code and style (its UI library reads its own small icons as data:
# addresses); pictures and places come from OpenStreetMap; nothing may embed the editor, though a
# document's own ".embed" view may be embedded anywhere.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' {{scripts}}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' data: https://tile.openstreetmap.org https://nominatim.openstreetmap.org https://tinier.tinylittleoffice.com; worker-src 'self'; frame-src 'self' about: blob:; object-src 'none'; base-uri 'self'; form-action 'self' mailto:
  Cache-Control: no-cache
# The pages themselves: no-transform, so Cloudflare does not rewrite them to add its analytics beacon (which the
# policy above would block anyway, leaving an error in every console). Only the HTML: the scripts keep their compression.
/
  ! Cache-Control
  Cache-Control: no-cache, no-transform
/:app/
  ! Cache-Control
  Cache-Control: no-cache, no-transform
# Built files carry a hash in their name: once fetched, they are never asked for again.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# For programs: the API as a module, its types, the guide and the small link-maker; any site may import them.
/api.js
  Access-Control-Allow-Origin: *
/api.d.ts
  Access-Control-Allow-Origin: *
/tinyoffice.js
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *
/files.json
  Access-Control-Allow-Origin: *
