{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "test",
    "e2e",
    "scripts",
    "dev",
    "vite.config.ts",
    "vite.api.config.ts",
    "vite.cli.config.ts",
    "vite.lib.config.ts",
    "packages",
    "selfhost",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "packages/doc/dist"]
}
