{
  "name": "tinylittleoffice",
  "version": "1.2.0-next",
  "description": "Tiny Little Office from the command line, in Node and on a page: links from files, files from links, the lint, the measures and the examples an agent checks a document by, and the library a program builds on (the document kernel, the commands, the editors and their stylesheet).",
  "keywords": [
    "office",
    "documents",
    "links",
    "agents",
    "llm",
    "markdown"
  ],
  "homepage": "https://tinylittleoffice.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/aboard-io/tinylittleoffice",
    "directory": "packages/doc"
  },
  "bugs": {
    "url": "https://github.com/aboard-io/tinylittleoffice/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/api.d.ts",
      "default": "./dist/api.js"
    },
    "./doc": {
      "types": "./dist/types/kernel.d.ts",
      "default": "./dist/doc.js"
    },
    "./commands": {
      "types": "./dist/types/commands.d.ts",
      "default": "./dist/commands.js"
    },
    "./editors": {
      "types": "./dist/types/editors.d.ts",
      "default": "./dist/editors.js"
    },
    "./kit": {
      "types": "./dist/types/kit.d.ts",
      "default": "./dist/editors.js"
    },
    "./board": {
      "types": "./dist/types/board.d.ts",
      "default": "./dist/board.js"
    },
    "./board/model": {
      "types": "./dist/types/apps/board/model.d.ts",
      "default": "./dist/board-model.js"
    },
    "./editors.css": {
      "types": "./editors.css.d.ts",
      "default": "./dist/editors.css"
    },
    "./board.css": {
      "types": "./board.css.d.ts",
      "default": "./dist/board.css"
    },
    "./examples/*.json": "./examples/*.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/api.js",
    "./dist/tinyoffice.js",
    "./dist/editors.js",
    "./dist/editors.css",
    "./dist/board.js",
    "./dist/board.css",
    "./dist/editors/*"
  ],
  "bin": {
    "tinylittleoffice": "dist/tinyoffice.js",
    "tinyoffice": "dist/tinyoffice.js"
  },
  "files": [
    "dist/api.js",
    "dist/tinyoffice.js",
    "dist/doc.js",
    "dist/commands.js",
    "dist/editors.js",
    "dist/editors.css",
    "dist/board.js",
    "dist/board-model.js",
    "dist/board.css",
    "editors.css.d.ts",
    "board.css.d.ts",
    "dist/editors",
    "dist/fonts",
    "dist/types",
    "dist/skill",
    "examples",
    "schema",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  }
}
