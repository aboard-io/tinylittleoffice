{
  "name": "tinyoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A tiny office suite that lives entirely in the URL.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "new-app": "node scripts/new-app.mjs",
    "icons": "node --experimental-strip-types scripts/make-icons.mjs"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lit": "^3.3.0",
    "lucide": "^0.544.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
