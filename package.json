{
  "name": "tinylittleoffice",
  "version": "1.2.0-next",
  "private": true,
  "type": "module",
  "description": "A tiny office suite where the link is the document.",
  "homepage": "https://tinylittleoffice.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/aboard-io/tinylittleoffice"
  },
  "bugs": {
    "url": "https://github.com/aboard-io/tinylittleoffice/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4178 --strictPort",
    "build": "node scripts/network-doc.ts && npm run -s lint && vite build && vite build -c vite.api.config.ts --logLevel warn && node scripts/budgets.ts",
    "build:verify": "node scripts/reproducible.ts",
    "build:cli": "vite build -c vite.cli.config.ts --mode api && vite build -c vite.cli.config.ts --mode cli",
    "verify-deploy": "node scripts/verify-deploy.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run -s tinier:types && tsc -p tinier && npm run -s site:types && tsc -p site",
    "lint": "tsc --noEmit && prettier --check . && node scripts/dead.ts && vitest run --project unit test/lints.test.ts test/stylesheets.test.ts test/scroll.test.ts",
    "format": "prettier --write .",
    "budgets": "node scripts/budgets.ts --sizes",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "walks": "VITE_WALK_STEPS=200 VITE_WALK_RUNS=2 VITE_WALK_FRESH=1 vitest run --project browser test/browser/walks.test.ts",
    "fuzz": "VITE_FUZZ_RUNS=2000 vitest run test/doc/properties.test.ts test/browser/paste-properties.test.ts",
    "deploy": "node scripts/deploy.mjs",
    "selfhost": "node --env-file-if-exists=.env selfhost/server.ts",
    "selfhost:build": "docker compose build",
    "selfhost:up": "docker compose up -d",
    "i18n:check": "node scripts/i18n-extract.ts --check",
    "i18n:extract": "node scripts/i18n-extract.ts",
    "i18n:gaps": "node scripts/i18n-extract.ts --gaps",
    "i18n:work": "node scripts/i18n-extract.ts --work",
    "i18n:sheet": "node scripts/i18n-extract.ts --sheet",
    "i18n:apply": "node scripts/i18n-extract.ts --apply",
    "docs:exports": "node scripts/exports-doc.ts",
    "docs:network": "node scripts/network-doc.ts",
    "docs:deps": "node scripts/dependencies.ts",
    "schema": "node scripts/schema.ts",
    "fonts:box": "bash scripts/fonts-box.sh",
    "icons": "node scripts/icons.ts",
    "emoji": "node scripts/emoji.ts",
    "skill": "node scripts/make-skill.ts",
    "commands": "node scripts/commands.ts",
    "cards": "node scripts/make-cards.ts",
    "samples": "node scripts/sample-cards.ts",
    "brand": "node scripts/brand.ts",
    "tinyoffice": "node packages/doc/tinyoffice.ts",
    "tinier:types": "wrangler types -c tinier/wrangler.jsonc tinier/worker-configuration.d.ts",
    "tinier:dev": "wrangler d1 migrations apply tinier -c tinier/wrangler.jsonc --local && wrangler dev -c tinier/wrangler.jsonc --port 8787 --var SITE:${SITE:-http://localhost:4178}",
    "site:types": "wrangler types -c wrangler.jsonc site/worker-configuration.d.ts",
    "site:dev": "wrangler d1 migrations apply tinier --local && wrangler dev --port 8789 --ip 0.0.0.0",
    "dictionary": "node scripts/dictionary.ts"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "d3-sankey": "0.12.3",
    "fflate": "0.8.3",
    "lit": "3.3.3",
    "lucide": "1.54.0",
    "maplibre-gl": "^6.14.0",
    "mathjs": "15.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fluent/syntax": "0.19.0",
    "@playwright/test": "1.64.0",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "26.6.4",
    "@vitest/browser-playwright": "5.0.3",
    "fast-check": "4.10.2",
    "playwright": "1.64.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
