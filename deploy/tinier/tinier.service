[Unit]
Description=tinier: link shortener for TinyLittleOffice (stores only ciphertext)
After=network.target

[Service]
ExecStart=/usr/bin/node /srv/tinier/server.mjs
Environment=PORT=8010
Environment=TINIER_DIR=/var/lib/tinier
StateDirectory=tinier
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
