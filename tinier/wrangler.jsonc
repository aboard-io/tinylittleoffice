// tinier, the link shortener, as a Worker: the ciphertext in D1, swept hourly.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinier",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  // Only on its own domain: no workers.dev copy once this is live.
  "workers_dev": false,
  "routes": [{ "pattern": "tinier.tinylittleoffice.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinier",
      // Filled in by `npx wrangler d1 create tinier` on the account the site deploys from.
      "database_id": "6ede155f-083c-4ab9-a33e-64eea0704bb5",
    },
  ],
  // A gentle brake on one address making or changing many links. Counted per Cloudflare location, in memory, never written down.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1", "simple": { "limit": 10, "period": 60 } }],
  // Expired links go every hour; a read of one goes sooner.
  "triggers": { "crons": ["17 * * * *"] },
  // No logs: the server learns that a link was made, and keeps even that to itself.
  "observability": { "enabled": false },
}
